const express = require("express");

const app = express();

/* Middleware */
app.use(express.json());

/* Routes */

// Root Route
app.get("/", (req, res) => {
  res.status(200).json({
    message: "Welcome to Capstone Project 🚀",
    success: true
  });
});

// Health Check (Cloud Friendly)
app.get("/health", (req, res) => {
  res.status(200).json({
    status: "OK",
    uptime: process.uptime(),
    timestamp: new Date()
  });
});

/* 404 Handler */
app.use((req, res) => {
  res.status(404).json({
    error: "Route not found",
    success: false
  });
});

/* Port (VERY IMPORTANT FOR RENDER) */
const PORT = process.env.PORT || 5000;

app.listen(PORT, () => {
  console.log(`🚀 Server running on port ${PORT}`);
});
